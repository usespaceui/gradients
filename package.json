{
  "name": "@usespaceui/gradients",
  "version": "0.1.3",
  "description": "Stunning, programmatic mesh gradients and organic color palettes.",
  "author": {
    "name": "SpaceUI",
    "email": "hello@spaceui.one",
    "url": "https://www.spaceui.one"
  },
  "contributors": [
    {
      "name": "SpaceUI Team",
      "email": "hello@spaceui.one",
      "url": "https://www.spaceui.one"
    }
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/usespaceui"
  },
  "license": "MIT",
  "homepage": "https://gradients.spaceui.one",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usespaceui/gradients.git"
  },
  "bugs": {
    "url": "https://github.com/usespaceui/gradients/issues",
    "email": "hello@spaceui.one"
  },
  "keywords": [
    "react",
    "gradients",
    "color",
    "palettes",
    "procedural",
    "generative",
    "spaceui",
    "mesh",
    "deterministic"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
