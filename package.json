{
    "name":  "@usespaceui/gradients",
    "version":  "0.1.2",
    "files":  [
                  "dist"
              ],
    "description":  "Procedural beautiful color palettes",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/usespaceui/gradients.git"
                   },
    "homepage":  "https://gradients.spaceui.one",
    "bugs":  {
                 "url":  "https://github.com/usespaceui/gradients/issues"
             },
    "keywords":  [
                     "react",
                     "gradients",
                     "color",
                     "palettes",
                     "procedural",
                     "generative",
                     "spaceui",
                     "mesh",
                     "deterministic"
                 ],
    "main":  "./dist/index.js",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "import":  {
                                             "types":  "./dist/index.d.ts",
                                             "default":  "./dist/index.mjs"
                                         },
                              "require":  {
                                              "types":  "./dist/index.d.cts",
                                              "default":  "./dist/index.js"
                                          }
                          },
                    "./package.json":  "./package.json"
                },
    "scripts":  {
                    "build":  "tsup",
                    "dev":  "tsup --watch",
                    "typecheck":  "tsc --noEmit"
                },
    "publishConfig":  {
                          "access":  "public"
                      },
    "devDependencies":  {
                            "tsup":  "^8.0.2",
                            "typescript":  "^5.3.3"
                        },
    "license":  "MIT"
}
